# Nexus backend — environment variables.
# Copy to .env and fill in. NEVER commit real values. Names only in this file.
# The server refuses to start when a required variable is missing (config/env.js).

# ── Required ─────────────────────────────────────────────────────────────
# MongoDB connection string (SECRET: contains the database password).
MONGO_URI=

# Signs the auth cookie JWT (SECRET). At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Browser origin(s) of the frontend allowed by CORS and the CSRF check.
# Exact origin, no trailing slash; comma-separate several. Required in production.
# (The old name CLIENT_URL is still read when this is unset.)
FRONTEND_URL=

# "production" on Render: Secure cookies, no localhost origin, trust proxy on.
NODE_ENV=

# ── Optional ─────────────────────────────────────────────────────────────
# Listen port. Render provides it; defaults to 3005 locally.
PORT=

# Auth cookie SameSite: lax | strict | none.
# Default: none in production (cross-site frontend), lax elsewhere.
# Set to lax once the frontend reaches the API through the Vercel /api rewrite.
COOKIE_SAMESITE=

# Number of reverse-proxy hops in front of the app (for the client IP used by
# rate limiting). Default: 1 in production, 0 elsewhere.
TRUST_PROXY=

# ── Seed scripts only (never set on Render) ──────────────────────────────
# Password given to the sample users by init/index.js (SECRET). Random if unset.
SEED_USER_PASSWORD=
# Must be exactly "yes" for a seed script to run with NODE_ENV=production.
ALLOW_PRODUCTION_SEED=
